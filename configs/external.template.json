{
  "name": "autopolicy-external",
  "root": "/data/zxy/autopolicy",
  "seed": 17,
  "max_iterations": 3,
  "success_target": 0.85,
  "stages": {
    "reconstruct": {
      "backend": "external",
      "command": ["python", "/path/to/reconstruct_adapter.py", "--input", "/data/zxy/autopolicy/data/real", "--output", "{stage_dir}"],
      "options": {"cwd": "{gpt6_real2sim}", "result": "result.json"}
    },
    "validate": {
      "backend": "external",
      "command": ["python", "/path/to/validation_adapter.py", "--run-dir", "{run_dir}", "--output", "{stage_dir}/result.json"]
    },
    "generate": {
      "backend": "external",
      "command": ["python", "/path/to/robotwin_cap_adapter.py", "--robotwin", "{robotwin}", "--output", "{stage_dir}"]
    },
    "dataset": {
      "backend": "external",
      "command": ["python", "/path/to/lerobot_converter.py", "--input", "{run_dir}/generate", "--output", "{stage_dir}"]
    },
    "train": {
      "backend": "external",
      "command": ["python", "{root}/scripts/train_lerobot_policies.py", "--lerobot-root", "{lerobot}", "--dataset-root", "/data/zxy/autopolicy/data/robotwin_clean_50/REPLACE_WITH_ONE_TASK", "--output-dir", "{stage_dir}"],
      "options": {"cwd": "{root}", "result": "result.json"}
    },
    "evaluate": {
      "backend": "external",
      "command": ["python", "/path/to/robotwin_eval_adapter.py", "--run-dir", "{run_dir}", "--output", "{stage_dir}/result.json"]
    },
    "deploy": {"backend": "disabled"},
    "improve": {"backend": "mock"}
  }
}
