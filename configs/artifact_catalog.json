{
  "name": "gpt6-robotwin-artifact-audit",
  "seed": 17,
  "max_iterations": 1,
  "success_target": 0.8,
  "stages": {
    "reconstruct": {
      "backend": "artifact",
      "options": {"source": "{root}/vendor/gpt6-real2sim/real2sim_ep0"}
    },
    "validate": {
      "backend": "artifact",
      "options": {
        "validation": "{root}/vendor/gpt6-real2sim/real2sim_ep0/validation.json",
        "max_camera_reprojection_px": 15.0,
        "max_penetration_m": 0.005,
        "max_trajectory_rmse_rad": 0.02,
        "max_placement_error_m": 0.15
      }
    },
    "generate": {"backend": "mock", "options": {"episodes": 4, "horizon": 4}},
    "dataset": {
      "backend": "catalog",
      "options": {
        "source": "{root}/data/robotwin_clean_50",
        "verify_files": true
      }
    },
    "train": {"backend": "disabled"},
    "evaluate": {"backend": "disabled"},
    "deploy": {"backend": "disabled"},
    "improve": {"backend": "disabled"}
  }
}
